# lint-agent 环境变量模板。复制为 .env 并填入真实值：
#   cp .env.example .env

# LLM 提供商：openai（默认）| anthropic
LLM_PROVIDER=openai

# API Key（openai 提供商也可用 OPENAI_API_KEY，anthropic 用 ANTHROPIC_API_KEY）
LLM_API_KEY=sk-your-api-key-here

# 兼容 OpenAI 接口的网关 base URL（可选，不填则走 OpenAI 官方）
LLM_BASE_URL=https://api.deepseek.com

# 模型名（openai 默认 gpt-4o，anthropic 默认 claude-sonnet-4-5）
LLM_MODEL=deepseek-chat

# 关闭兼容网关的思考模式（智谱 GLM-4.5+ 等，1 = 关闭）
LLM_DISABLE_THINKING=1

# 相邻请求最小间隔（毫秒），规避免费档限流（0 = 不节流）
LLM_MIN_INTERVAL_MS=2000