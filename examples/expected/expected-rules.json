  "testCases": [
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isIOS) {\n  jue.system.getSystemInfo();\n}",
      "shouldReport": true,
      "ruleName": "no-system-getsysteminfo"
    },
    {
      "code": "import jue from '@/sdk/jue/2.30.0';\nif (isIOS) {\n  jue.system.getSystemInfo();\n}",
      "shouldReport": false,
      "ruleName": "no-system-getsysteminfo"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isAndroid) {\n  jue.system.getSystemInfo();\n}",
      "shouldReport": false,
      "ruleName": "no-system-getsysteminfo"
    },
    {
      "code": "import jue from '@/sdk/jue/2.15.0';\nif (isIOS) {\n  jue.system.getAppVersion();\n}",
      "shouldReport": true,
      "ruleName": "no-system-getappversion"
    },
    {
      "code": "import jue from '@/sdk/jue/2.30.0';\nif (isIOS) {\n  jue.system.getAppVersion();\n}",
      "shouldReport": false,
      "ruleName": "no-system-getappversion"
    },
    {
      "code": "import jue from '@/sdk/jue/2.15.0';\nif (isIOS) {\n  jue.system.getSDKVersion();\n}",
      "shouldReport": true,
      "ruleName": "no-system-getsdkversion"
    },
    {
      "code": "import jue from '@/sdk/jue/2.20.0';\nif (isIOS) {\n  jue.system.getSDKVersion();\n}",
      "shouldReport": false,
      "ruleName": "no-system-getsdkversion"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isHarmony) {\n  jue.system.getBatteryInfo();\n}",
      "shouldReport": true,
      "ruleName": "no-system-getbatteryinfo"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isIOS) {\n  jue.system.getBatteryInfo();\n}",
      "shouldReport": false,
      "ruleName": "no-system-getbatteryinfo"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isHarmony) {\n  jue.network.connectSocket({});\n}",
      "shouldReport": true,
      "ruleName": "no-network-connectsocket-on-harmony"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isAndroid) {\n  jue.network.connectSocket({});\n}",
      "shouldReport": false,
      "ruleName": "no-network-connectsocket-on-harmony"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isHarmony) {\n  jue.event.once('x', () => {});\n}",
      "shouldReport": true,
      "ruleName": "no-event-once-on-harmony"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\nif (isIOS) {\n  jue.event.once('x', () => {});\n}",
      "shouldReport": false,
      "ruleName": "no-event-once-on-harmony"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\njue.system.getClipboard();",
      "shouldReport": true,
      "ruleName": "no-system-getclipboard"
    },
    {
      "code": "import jue from '@/sdk/jue/2.10.0';\njue.clipboard.getClipboardData();",
      "shouldReport": false,
      "ruleName": "no-system-getclipboard"
    }
  ]
